# Angel One SmartAPI credentials.
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# WARNING: these authenticate a FULL TRADING ACCOUNT. Angel One issues no
# read-only credential. Treat this file's real counterpart like a password.

# From the SmartAPI developer console (My Apps)
ANGEL_API_KEY=

# Your Angel One login / client code, e.g. A123456
ANGEL_CLIENT_CODE=

# Your trading MPIN
ANGEL_MPIN=

# Base32 TOTP secret shown once when enabling 2FA for the API.
# Used to generate the 6-digit code locally at login.
ANGEL_TOTP_SECRET=
