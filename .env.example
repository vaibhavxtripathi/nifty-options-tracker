# Angel One SmartAPI credentials — variable NAMES only, never values.
#
# WARNING: these authenticate a FULL TRADING ACCOUNT. Angel One issues no
# read-only market-data credential. Treat the real values like a password.
#
# This file is documentation, not configuration. The app does NOT read a .env
# file: values are passed at build time with --dart-define, so no credentials
# file exists on disk or inside the APK. See README §7 for why that is a
# smaller attack surface rather than a secure one.
#
#   flutter run \
#     --dart-define=ANGEL_API_KEY=... \
#     --dart-define=ANGEL_CLIENT_CODE=... \
#     --dart-define=ANGEL_MPIN=... \
#     --dart-define=ANGEL_TOTP_SECRET=...
#
# Omit them all and the app still runs: auth, contract search and replay mode
# work without a broker account.

# From the SmartAPI developer console (My Apps)
ANGEL_API_KEY=

# Your Angel One login / client code, e.g. A123456
ANGEL_CLIENT_CODE=

# Your trading MPIN
ANGEL_MPIN=

# Base32 TOTP secret, shown once when enabling 2FA for the API.
# Used to generate the 6-digit code locally at login.
ANGEL_TOTP_SECRET=

# The Google OAuth **Web** client ID from the Firebase console. Not a secret —
# an OAuth client ID is a public identifier, and the same value already ships
# inside google-services.json. Optional on Android, where the plugin reads it
# from that file. It must be the Web client ID: the Android one yields a null
# idToken at sign-in with no useful error message.
GOOGLE_SERVER_CLIENT_ID=
