# Secrets — never commit
.env
*.env
!.env.example

# Phase 0 throwaway: live broker session tokens. Never commit.
tool/.session.json

# Flutter / Dart
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies

# pubspec.lock IS committed. This is an application, not a library: the
# lockfile is what makes a build reproduce the dependency versions the app was
# actually tested against. (A library omits it, since its consumers resolve
# their own.) It was ignored in Phase 0 when this was a throwaway script
# package.

